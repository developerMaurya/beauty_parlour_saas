# ==============================================================================
# BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
APP_NAME=BeautySaaS
API_PREFIX=/api/v1
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Central Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/beauty_saas_central
CENTRAL_MONGODB_URI=mongodb://127.0.0.1:27017/beauty_saas_central

# JWT Token Configuration
JWT_ACCESS_SECRET=your_super_secret_access_token_key_here_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_here_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=beauty-saas
JWT_AUDIENCE=beauty-saas-api

# Cookie & Session Configuration
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Super Admin Initial Bootstrap Credentials (For scripts/bootstrap-superadmin.js)
SUPERADMIN_BOOTSTRAP_NAME=Master Super Admin
SUPERADMIN_BOOTSTRAP_EMAIL=superadmin@beautysaas.local
SUPERADMIN_BOOTSTRAP_USERNAME=superadmin
SUPERADMIN_BOOTSTRAP_PASSWORD=SuperAdmin@Secure2026!

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Logging
LOG_LEVEL=info
